# ---------------------------------------------------------------------------
# Copy this file to `.env` in this folder and edit the values.
#   Windows (cmd):  copy .env.example .env
#   Git Bash:        cp .env.example .env
#
# NEVER commit the real `.env`. Every setting below is optional in
# development - the app boots with in-memory storage and no API keys, but
# ENVIRONMENT=production refuses to start without keys AND a database.
# Variable names are the upper-case form of the field name in
# app/core/config.py (e.g. face_match_threshold -> FACE_MATCH_THRESHOLD).
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- API security ----------------------------------------------------------
# Two tiers, sent by the client as the `X-API-Key` header:
#   ADMIN_API_KEY   -> student CRUD + face-photo uploads (biometric data)
#   TEACHER_API_KEY -> reads, recognition, attendance, manual corrections
# Leave BOTH empty to disable authentication (development only - the app
# refuses to start with ENVIRONMENT=production while both are empty).
ADMIN_API_KEY=
TEACHER_API_KEY=

# Login accounts for POST /api/auth/login (single-school development set).
# Leave the passwords EMPTY to disable login entirely; the API then only
# accepts API keys (or runs unauthenticated when both keys are also empty).
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(20))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=
# Signs the session token. Generate one; never commit a real value.
AUTH_SECRET=
SESSION_TTL_MINUTES=480
# true  = API keys AND login tokens are accepted (backward compatible)
# false = login tokens only
ALLOW_API_KEY_AUTH=true

# Browser origins allowed by CORS. The Next.js dev server runs on :3000, so
# keep those two entries if you serve the frontend locally.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (MongoDB) -----------------------------------------------------
# Leave MONGODB_URI EMPTY to use the in-memory store: fast, zero setup, but all
# data is lost on restart. Set it to persist.
#
#   MongoDB Atlas (supports native $vectorSearch):
#     MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
#   Local MongoDB:
#     MONGODB_URI=mongodb://127.0.0.1:27017
#
# Never commit the real `.env` - credentials must not be hard-coded.
MONGODB_URI=
# NOTE: MongoDB database names cannot contain spaces, '.', '/', '\', '"' or '$'.
# Use underscores: ai_attendance
MONGODB_DATABASE=ai_attendance
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- School scoping ---------------------------------------------------------
# Every student, face embedding and attendance row is stored with this schoolId,
# and the vector search is filtered by it, so one school can never match
# another school's students. Change it to run a different school.
SCHOOL_ID=default
SCHOOL_NAME=Default School

# Dimension of the face-embedding vectors. 512 is what the current pretrained
# model (InsightFace buffalo_l / ArcFace) produces - do not change it unless the
# face model is replaced, and re-create the vector index if you do.
EMBEDDING_DIM=512

# --- File storage ----------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10            # photos larger than this are rejected (413)

# --- Face recognition (pretrained ArcFace / buffalo_l) ---------------------
# Cosine-similarity threshold, NOT a probability. Higher = stricter.
# 0.35-0.60 is the useful range; tune it on your own data.
FACE_MATCH_THRESHOLD=0.45

# Identification margin: minimum gap between the best candidate and the best
# candidate from a DIFFERENT student. A face whose lead is smaller than this
# is reported as UNKNOWN even when it clears the threshold (0.51 vs 0.49 must
# not be accepted). 0 disables the gate. Starting value 0.05 - tune it on
# your own data; it is a starting point, not a calibrated optimum.
FACE_MATCH_MARGIN=0.05

FACE_MODEL_NAME=buffalo_l        # detector + ArcFace recognition package
FACE_MODEL_ROOT=~/.insightface   # weights are downloaded here on first run

FACE_DET_SIZE=640                # detector input size (pixels)
FACE_DET_THRESH=0.5              # detector confidence floor
FACE_MIN_FACE_SIZE=60            # reject faces whose smaller side is under this

# Leave empty for automatic selection (CoreML -> CUDA -> CPU).
#   Force CPU:  FACE_PROVIDERS=CPUExecutionProvider
#   Force CUDA: FACE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
FACE_PROVIDERS=

# --- Recognition / registration --------------------------------------------
RECOGNITION_CANDIDATES=15        # embeddings fetched per detected face; keep well above FACES_PER_STUDENT_MAX
MAX_FACES_PER_IMAGE=300          # hard cap on faces accepted in one photo
FACES_PER_STUDENT_MIN=3          # below this the student is flagged not ready
FACES_PER_STUDENT_MAX=10         # 3-10 photos recommended per student

# A registration photo this similar to one already stored for the same student
# is rejected (409 duplicate_face). Keep it VERY HIGH: two photos taken
# back-to-back of one still student score 0.85-0.97, while re-uploading the
# exact same file scores ~1.00. This catches accidental re-uploads only.
DUPLICATE_FACE_SIMILARITY=0.98